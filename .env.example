# Environment variables for Person Detection & Re-identification
# Copy this file to .env and fill in your values
# docker compose will automatically load .env if present

# =============================================================================
# Email Configuration (required for email alerts)
# =============================================================================
# Gmail: Use an App Password (16 chars), not your regular password
# https://support.google.com/accounts/answer/185833
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_RECEIVER=recipient_email@gmail.com

# SMTP Server (Gmail defaults shown)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# =============================================================================
# Detection Configuration
# =============================================================================
# Linux and Windows: open the dashboard, select a camera, and click Start camera.
# Keep the browser tab open; no host helper or Python installation is needed.
# Other sources: SOURCE=/app/data/test.mp4 or SOURCE=rtsp://...
SOURCE=browser
# Optional Linux unattended capture: set SOURCE=0 and uncomment devices in Compose.
VIDEO_DEVICE=/dev/video0

# YOLO model file (must be a segmentation model: *-seg.pt)
MODEL=yolo26n-seg.pt

# Detection confidence threshold (0.0-1.0)
CONF=0.25

# Inference image size (pixels)
IMGSZ=640

# auto uses CUDA when available, otherwise CPU.
# Uncomment the deploy block in docker-compose.yml to expose an NVIDIA GPU.
DEVICE=auto

# Run detection on every Nth video/stream frame. Browser uploads run at up to 4 fps.
FRAME_GAP=15

# Cosine similarity threshold for re-identification (0.0-1.0)
# Higher = stricter matching, fewer false positives but more "new person" alerts
THRESHOLD=0.70

# Short-term tracking thresholds
TRACK_THRESHOLD=0.60
TRACK_IOU=0.3
TRACK_TIMEOUT=3.0

# Minimum person box height (pixels) to process
MIN_BOX=48

# Seconds between stored samples of the same identity
SAMPLE_INTERVAL=3.0

# Maximum samples per identity kept in memory
MAX_SAMPLES=30

# Gallery folder for stored identities
GALLERY=/app/gallery_segmented

# Minimum seconds between alert emails for the same new person
COOLDOWN=60.0

# =============================================================================
# Dashboard Configuration
# =============================================================================
# Enable the web dashboard
DASHBOARD=true

# Dashboard bind address (0.0.0.0 = accessible from network)
HOST=0.0.0.0

# Dashboard port on both host and container (published to localhost only)
DASHBOARD_PORT=5000

# Number of recent detections shown on dashboard
LATEST_COUNT=12

# =============================================================================
# Optional Flags (uncomment to enable)
# =============================================================================
# Use STARTTLS instead of SMTP_SSL (for port 587)
# NO_SSL=true

# Disable email alerts entirely
# NO_EMAIL=true

# Verbose logging (log every re-identification, not just new people)
# VERBOSE=true
